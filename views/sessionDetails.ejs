<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Session Details</title>
</head>
<body>
    <%- include('publics/navbar') %>

    <div class="container mt-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h1 class="mb-0">Study Session Details</h1>
            </div>

            <div class="card-body">
                <h2 class="card-title"><%= session.subject %></h2>

                <p class="card-text">
                    <strong>Date:</strong> <%= session.date %>
                </p>

                <p class="card-text">
                    <strong>Duration:</strong> <%= session.duration %> hour(s)
                </p>

                <p class="card-text">
                    <strong>Productivity Rating:</strong> <%= session.rating %>/5
                </p>

                <p class="card-text">
                    <strong>Notes:</strong> <%= session.notes %>
                </p>

                <a href="/sessions" class="btn btn-secondary">
                    Back to Sessions
                </a>
            </div>
        </div>
    </div>
</body>
</html>