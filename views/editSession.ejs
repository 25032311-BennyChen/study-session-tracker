<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <title>Add Study Session</title>
</head>
<body>
  <%- include ('publics/navbar') %>
     <div class="container mt-3">
        <h2> Edit Study Session</h2>
        <form action="/submit2/<%= id %>" method="post">
            <div class="mb-3 mt-3">
                <label for="subject">Subject:</label>
                <input type="text" class="form-control" id="subject" placeholder="Enter Subject Name" name="subject" value="<%= session.subject %>" required>
            </div>
            <div class="mb-3 mt-3">
                <label for="date">Date:</label>
                <input type="date" class="form-control" id="date" name="date" value="<%= session.date %>" required>
            </div>
            <div class="mb-3 mt-3">
                <label for="hours">Duration in hours:</label>
                <input type="number" class="form-control" id="hours" placeholder="Enter Hours " name="duration" step="0.5" value="<%= session.duration %>" required>
            </div>
            <div class="mb-3 mt-3">
                <label for="rating">Productivity Rating:</label>
                <select class="form-control" id="rating" name="rating">
                    <option value="1"<%= session.rating == 1 ? 'selected' : '' %>>1 - Poor</option>
                    <option value="2"<%= session.rating == 2 ? 'selected' : '' %>>2 - Okay</option>
                    <option value="3"<%= session.rating == 3 ? 'selected' : '' %>>3 - Good</option>
                    <option value="4"<%= session.rating == 4 ? 'selected' : '' %>>4 - Very Good</option>
                    <option value="5" <%= session.rating == 5 ? 'selected' : '' %>>5 - Excellent</option>
                </select>
            </div>
            <div>
                <label for="notes">Notes:</label>
                <textarea class="form-control" id="notes" placeholder="Enter Notes" name="notes" required ><%= session.notes %></textarea>
            </div>
            
            <button type="submit" class="btn btn-primary">Update Session</button>
        </form>
</body>
</html>