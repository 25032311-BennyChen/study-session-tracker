<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>All Study Sessions</title>
</head>
<body>
    <%- include('publics/navbar') %>

    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>All Study Sessions</h1>

            <a href="/add" class="btn btn-primary">
                Add New Study Session
            </a>
        </div>

        <form action="/sessions" method="GET" class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">Filter by Subject:</label>

                <select name="subject" class="form-select">
                    <option value="">All Subjects</option>

                    <% subjects.forEach((subject) => { %>
                        <option value="<%= subject %>" 
                            <%= selectedSubject === subject ? 'selected' : '' %>>
                            <%= subject %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-success w-100">
                    Filter
                </button>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <a href="/sessions" class="btn btn-secondary w-100">
                    Reset
                </a>
            </div>
        </form>

        <% if (studySessions.length === 0) { %>
            <div class="alert alert-warning">
                No study sessions found.
            </div>
        <% } %>

        <div class="row">
            <% studySessions.forEach((session, index) => { %>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <%= session.subject %>
                            </h5>

                            <p class="card-text mb-1">
                                <strong>Date:</strong> <%= session.date %>
                            </p>

                            <p class="card-text mb-1">
                                <strong>Duration:</strong> <%= session.duration %> hour(s)
                            </p>

                            <p class="card-text mb-1">
                                <strong>Productivity Rating:</strong> <%= session.rating %>/5
                            </p>

                            <p class="card-text">
                                <strong>Notes:</strong> <%= session.notes %>
                            </p>
                        </div>

                        <div class="card-footer bg-white">
                            <a href="/sessions/<%= index %>" class="btn btn-outline-primary btn-sm">
                                View Details
                            </a>

                            <a href="/sessions/<%= index %>/edit" class="btn btn-outline-warning btn-sm">
                                Edit
                            </a>

                            <form action="/sessions/<%= index %>/delete" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>